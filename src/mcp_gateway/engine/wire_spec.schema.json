{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WireSpecSchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema_version",
    "min_broker_version",
    "rpc_descriptors",
    "dom_selectors"
  ],
  "properties": {
    "$schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "min_broker_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rpc_descriptors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_notebooks",
        "get_notebook_metadata",
        "create_note",
        "delete_note",
        "upload_intent"
      ],
      "properties": {
        "list_notebooks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id", "response_mapping"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            },
            "request_template": {
              "type": "string"
            },
            "response_mapping": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "get_notebook_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id", "rows"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            },
            "rows": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "create_note": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            },
            "param_structure": {
              "type": "string"
            }
          }
        },
        "delete_note": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            },
            "param_structure": {
              "type": "string"
            }
          }
        },
        "upload_intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            },
            "unpack_depth": {
              "type": "integer"
            }
          }
        },
        "add_source_url": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            }
          }
        },
        "add_source_drive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id"],
          "properties": {
            "method_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_$]{1,32}$"
            }
          }
        },
        "query_stream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint_url": {
              "type": "string"
            },
            "query_origin": {
              "type": "integer"
            }
          }
        }
      }
    },
    "dom_selectors": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9_$]{1,64}$": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_$]{1,64}$"
        }
      }
    }
  }
}
