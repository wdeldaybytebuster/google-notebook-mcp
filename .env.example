# ==============================================================================
# Google Gemini Notebook MCP Gateway — Environment Configuration Example
# Copy this file to '.env' to configure local overrides.
# ==============================================================================

# Path to Google Chrome or Chromium executable (autodetected by default)
# Linux:
# CHROME_PATH=/usr/bin/google-chrome-beta
# macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Remote debugging port for dedicated Chrome companion profile (default: 9222)
# CDP_PORT=9222

# Unix domain socket or named pipe path for broker IPC (optional; uses system default)
# Linux / macOS default: /tmp/notebooklm-mcp-broker.sock
# Windows default: \\.\pipe\notebooklm-mcp-broker
# MCP_BROKER_SOCKET=/tmp/notebooklm-mcp-broker.sock

# Thread pool cap for constrained environments (default: 3)
UV_THREADPOOL_SIZE=3
